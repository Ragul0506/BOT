# ══════════════════════════════════════════════════════════════════
#  Copy this to .env and fill in your values for local dev.
#  On Render.com, set these in the Dashboard → Environment tab.
# ══════════════════════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────────────────────
# Get from @BotFather → /newbot
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ── Groq (free) ───────────────────────────────────────────────────
# https://console.groq.com → API Keys → Create Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── TMDB (free) ───────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api → Request Developer key
TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Custom Search (free: 100 queries/day) ──────────────────
# API Key : https://console.cloud.google.com → APIs & Services → Credentials
# CSE ID  : https://programmablesearchengine.google.com → Create engine
GOOGLE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_CSE_ID=XXXXXXXXXXXXXXXXX

# ── Google Sheets (expense tracker, free) ─────────────────────────
# 1. Cloud Console → enable Google Sheets API
# 2. IAM → Service Accounts → Create → Download JSON key
# 3. Paste the ENTIRE JSON content (minified) as the value below
# 4. Create a Google Spreadsheet; share it with the service-account email
# 5. Copy the spreadsheet ID from its URL
GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Supabase (watchlist, free tier: 2 projects) ───────────────────
# https://supabase.com → New project → Settings → API
# Run in SQL editor:
#   CREATE TABLE watchlist (
#       id BIGSERIAL PRIMARY KEY,
#       user_id TEXT NOT NULL,
#       movie_id INTEGER NOT NULL,
#       title TEXT NOT NULL,
#       poster_url TEXT,
#       added_at TIMESTAMPTZ DEFAULT NOW(),
#       UNIQUE (user_id, movie_id)
#   );
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Local dev only ────────────────────────────────────────────────
# Leave blank for polling mode.
# Render sets RENDER_EXTERNAL_URL automatically — do NOT set it manually.
RENDER_EXTERNAL_URL=
PORT=8443
